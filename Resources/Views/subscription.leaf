#extend("base"):
#export("title"):#(name)#endexport
#export("body"):
<h1>#(name)</h1>
<p class="id"><a href="#(youtubeURL)">#(kind) #(youtubeID)</a>#if(grabList): · grab list: every video is filed under Grabs as a film#endif</p>
<form method="post" action="/subscriptions/#(id)/poll" class="inline"><button>Poll now</button></form>
<form method="post" action="/subscriptions/#(id)/enumerate" class="inline"><button class="quiet">List the whole #(kind)</button></form>
<p class="note">A poll sees only the newest 15 to 20 videos. Listing the whole #(kind) finds everything older that the rules below want, including videos skipped before for their date; it runs in the background and the journal says when it is done. Clear the cutoff first to fetch the whole back catalogue.</p>

<h2>Rules</h2>
<form method="post" action="/subscriptions/#(id)" class="rules">
  <label>Show name <input name="name" value="#(rules.name)"></label>
  <label><input type="checkbox" name="enabled" #if(rules.enabled):checked#endif> Enabled</label>
  <label>Cutoff (uploaded on or after) <input name="cutoff" type="date" value="#(rules.cutoff)"></label>
  <label>Title must match <input name="titleInclude" value="#(rules.titleInclude)" placeholder="regular expression"></label>
  <label>Title must not match <input name="titleExclude" value="#(rules.titleExclude)" placeholder="regular expression"></label>
  <label>At least <input name="minMinutes" value="#(rules.minMinutes)" size="4"> minutes</label>
  <label>At most <input name="maxMinutes" value="#(rules.maxMinutes)" size="4"> minutes</label>
  <label><input type="checkbox" name="shorts" #if(rules.shorts):checked#endif> Include Shorts</label>
  <label><input type="checkbox" name="livestreams" #if(rules.livestreams):checked#endif> Include livestream recordings</label>
  <label><input type="checkbox" name="autoCaptions" #if(rules.autoCaptions):checked#endif> YouTube's automatic captions when there are no real ones</label>
  <label>Quality
    <select name="quality">
      <option value="1080p" #if(rules.quality == "1080p"):selected#endif>Up to 1080p</option>
      <option value="2160p" #if(rules.quality == "2160p"):selected#endif>Up to 2160p (4K)</option>
      <option value="720p" #if(rules.quality == "720p"):selected#endif>Up to 720p</option>
    </select></label>
  <label>SponsorBlock
    <select name="sponsorBlock">
      <option value="cut" #if(rules.sponsorBlock == "cut"):selected#endif>Cut</option>
      <option value="mark" #if(rules.sponsorBlock == "mark"):selected#endif>Mark as chapters</option>
      <option value="off" #if(rules.sponsorBlock == "off"):selected#endif>Off</option>
    </select>
    <input name="sponsorBlockCategories" value="#(rules.sponsorBlockCategories)"></label>
  <label>Keep
    <select name="retention">
      <option value="all" #if(rules.retention == "all"):selected#endif>everything</option>
      <option value="newest" #if(rules.retention == "newest"):selected#endif>the newest</option>
      <option value="days" #if(rules.retention == "days"):selected#endif>the last days:</option>
    </select>
    <input name="retentionCount" value="#(rules.retentionCount)" size="4"></label>
  <button>Save rules</button>
</form>

<h2>Videos</h2>
<table class="videos">
  <thead><tr><th>Video</th><th>Show</th><th>When</th><th>State</th><th>Why</th><th></th></tr></thead>
  <tbody>
  #for(v in videos):
    <tr class="#(v.state)">
      <td><a href="#(v.url)">#(v.title)</a><div class="id">#(v.id)#if(v.number != ""): · #(v.number)#endif</div></td>
      <td><a href="/subscriptions/#(v.showID)">#(v.show)</a></td>
      <td class="when">#(v.when)</td>
      <td><span class="pill #(v.state)">#(v.stateLabel)</span></td>
      <td class="why">#(v.why)</td>
      <td class="actions">
        #if(v.state == "failed" || v.state == "deferred" || v.state == "skipped"):
          <form method="post" action="/videos/#(v.id)/retry"><button>#if(v.state == "skipped"):Want#else:Retry now#endif</button></form>
        #endif
        #if(v.state == "failed" || v.state == "deferred" || v.state == "wanted"):
          <form method="post" action="/videos/#(v.id)/skip"><button class="quiet">Skip</button></form>
        #endif
      </td>
    </tr>
  #endfor
  </tbody>
</table>


<h2>Keep only from a date</h2>
<form method="post" action="/subscriptions/#(id)/keep" class="danger" onsubmit="return confirm('Delete every #(name) episode uploaded before this date? This cannot be undone.')">
  <input name="from" type="date" required>
  <button class="quiet">Delete older episodes and set the cutoff</button>
</form>

<form method="post" action="/subscriptions/#(id)/delete" class="danger" onsubmit="return confirm('Unfollow #(name)? Files already in the library stay.')">
  <button class="quiet">Unfollow</button>
</form>
#endexport
#endextend
