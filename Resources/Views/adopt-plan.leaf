<h2>The first operations</h2>
<pre class="plan">#for(s in sample):#(s)
#endfor</pre>
<form method="post" action="/adopt/run" onsubmit="return confirm('Run the adoption? Files will be moved.')"><button>Run the adoption</button></form>
<p><a href="/adopt?source=#(source)">Back</a></p>
#endexport
#endextend
