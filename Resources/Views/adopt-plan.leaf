#export("title"):Adoption plan#endexport
#export("body"):
<h1>Adoption plan for #(source)</h1>
<table class="subs"><tbody>
#for(l in summary):<tr><td>#(l.label)</td><td>#(l.count)</td></tr>#endfor
</tbody></table>
<p>#(batches) videos, #(gigabytes) GB to move. Moves within one filesystem are renames; across filesystems each file is copied, its size checked, and only then is the original removed.</p>
#if(count(problems) > 0):<h2>Not adopted, and why</h2><ul>#for(p in problems):<li>#(p)</li>#endfor</ul>#endif
