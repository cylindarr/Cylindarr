#extend("base"):
#export("title"):Settings#endexport
#export("body"):
#extend("banners")
<h1>Settings</h1>
#if(hasPinned):<p class="note">Set by the environment, and so not changeable here: #for(p in pinned):<code>#(p)</code> #endfor</p>#endif
<form method="post" action="/settings" class="rules">
  <h2>Library</h2>
  <label>Library root <input name="libraryRoot" value="#(s.libraryRoot)" size="40"></label>
  <label>Subtitle languages <input name="subtitleLanguages" value="#(s.subtitleLanguages)" size="12"></label>
  <label>Pause fetching below <input name="minFreeGB" value="#(s.minFreeGB)" size="5"> GB free</label>
  <label>Poll every <input name="pollMinutes" value="#(s.pollMinutes)" size="4"> minutes</label>
  <label><input type="checkbox" name="fetching" #if(s.fetching):checked#endif> Fetch wanted videos</label>
  <h2 id="youtube">Reaching YouTube</h2>
  <label>yt-dlp <input name="ytdlpPath" value="#(s.ytdlpPath)" size="40"></label>
  <label><input type="checkbox" name="autoUpdate" #if(s.autoUpdate):checked#endif> Update yt-dlp daily (checksum checked, switched only after the access check passes)</label>
  <label>PO token provider <input name="potProvider" value="#(s.potProvider)" size="32" placeholder="http://pot:4416"></label>
  <label>Proxy for yt-dlp <input name="proxy" value="#(s.proxy)" size="32" placeholder="socks5://user:password@host:1080 (blank for direct)"></label>
  <h2 id="media-servers">Media servers</h2>
  <label>Plex URL <input name="plexURL" value="#(s.plexURL)" size="32" placeholder="http://host.docker.internal:32400"></label>
  <label>Plex token <input name="plexToken" type="password" placeholder="unchanged" size="24"></label>
  <label>Plex TV section id <input name="plexSection" value="#(s.plexSection)" size="4"></label>
  <label>Plex Grabs section id <input name="plexGrabsSection" value="#(s.plexGrabsSection)" size="4"></label>
  <label>Plex sees the library at <input name="plexPathMap" value="#(s.plexPathMap)" size="32" placeholder="/data/youtube=/media/youtube (blank if the same)"></label>
  <label>Jellyfin URL <input name="jellyfinURL" value="#(s.jellyfinURL)" size="32"></label>
  <label>Jellyfin API key <input name="jellyfinKey" type="password" placeholder="unchanged" size="24"></label>
  <label>Jellyfin sees the library at <input name="jellyfinPathMap" value="#(s.jellyfinPathMap)" size="32" placeholder="/data/youtube=/media/youtube (blank if the same)"></label>
  <h2>Notifications</h2>
  <label>ntfy topic URL <input name="ntfyURL" value="#(s.ntfyURL)" size="40"></label>
  <button>Save settings</button>
</form>

<h2 id="cookies">Cookies</h2>
<p>#(cookies)</p>
<p class="note">So they last: open a private window, sign in to YouTube with the account made for this, export <code>cookies.txt</code> from that window, then close it without using YouTube there again. A session left open in a browser rotates and the exported copy stops working within days. Cookies are used only when a video needs them.</p>
<p class="note">Only the YouTube and Google cookies in the file are kept; the rest of an export is discarded.</p>
<form method="post" action="/settings/cookies" enctype="multipart/form-data">
  <input type="file" name="cookies" accept=".txt,text/plain" required>
  <button>Upload cookies</button>
</form>
#if(hasCookies):
<form method="post" action="/settings/cookies/remove" class="danger" onsubmit="return confirm('Remove the cookies? Videos that need a signed-in account will fail until new ones are uploaded.')">
  <button class="quiet">Remove cookies</button>
</form>
#endif

<h2 id="encoding">Encoding</h2>
<p>#if(encodes):Every download is encoded to #(encoder), with its SponsorBlock segments cut in the same pass.#else:Downloads are placed as YouTube served them, without an encode. SponsorBlock segments are marked as chapters, not cut.#endif</p>
<form method="post" action="/settings/encoding" class="rules">
  <label>Encoder <select name="encoder">#for(c in encoderChoices):<option value="#(c.value)" #if(c.selected):selected#endif>#(c.label)</option>#endfor</select></label>
  <label>Quality <input name="encodeQuality" value="#(s.encodeQuality)" size="3"> (QP or CRF; lower is better and larger, 24 is about YouTube's own bitrate)</label>
  <button>Save encoding</button>
</form>
<p class="note">Downloading the library again replaces every placed video with a new download and encode. Each keeps its episode number and its current file until the new one is placed, and new uploads go first.</p>
<form method="post" action="/library/again" class="danger" onsubmit="return confirm('Download and encode every placed video again? This takes a day or more for a large library.')">
  <button class="quiet">Download the library again</button>
</form>
#endexport
#endextend
